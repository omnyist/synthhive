:80 {
	@backend path /api/* /admin/* /auth/* /invite/* /setup/* /static/* /health/*

	handle @backend {
		reverse_proxy server:7177 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server

		# Hashed bundles are immutable; index.html (and every SPA route
		# that falls back to it) must revalidate, or browsers heuristically
		# cache the shell and keep loading last week's bundle.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
	}
}
